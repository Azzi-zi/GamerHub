<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101016">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Шапка -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="СООБЩЕНИЯ"
                        android:textColor="#A970FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.16" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Твои игроки"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Общайся с командой и друзьями"
                        android:textColor="#92929F"
                        android:textSize="13sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/newChatButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_create_button"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:contentDescription="Создать чат"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="4dp" />

            </LinearLayout>

            <!-- Поиск игроков -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌕"
                    android:textColor="#B784FF"
                    android:textSize="29sp" />

                <EditText
                    android:id="@+id/chatSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Найти игрока..."
                    android:inputType="text"
                    android:singleLine="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#777783"
                    android:textSize="14sp"
                    android:imeOptions="actionSearch" />

            </LinearLayout>

            <!-- Результаты поиска -->
            <LinearLayout
                android:id="@+id/playerSearchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Раздел переписок -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="#A970FF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="ТВОИ ПЕРЕПИСКИ"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.07" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GAMERHUB"
                    android:textColor="#777080"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

            <!-- Состояние списка: загрузка или пустой список -->
            <TextView
                android:id="@+id/chatsEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#191820"
                android:gravity="center"
                android:padding="24dp"
                android:text="У тебя пока нет чатов.\nНажми +, чтобы найти игрока."
                android:textColor="#AAA7B6"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:visibility="visible" />

            <!-- ChatsManager добавляет реальные переписки сюда -->
            <LinearLayout
                android:id="@+id/chatsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <!-- Нижняя подпись -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="GG  •  GOOD GAME, GOOD COMPANY"
                android:textColor="#55515F"
                android:textSize="10sp"
                android:letterSpacing="0.08" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
