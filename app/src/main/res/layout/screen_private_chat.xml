<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121216"
    android:focusableInTouchMode="true">

    <!-- Верхняя панель переписки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#1A1A20">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:text="‹"
            android:textSize="36sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Назад" />
        <ImageView
            android:id="@+id/chatAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="Аватар собеседника" />

        <TextView
            android:id="@+id/chatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Имя игрока"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:paddingStart="8dp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- История сообщений -->
    <ScrollView
        android:id="@+id/messagesScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="12dp"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/messagesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <!-- Нижняя панель ввода -->
    <LinearLayout
        android:id="@+id/messageInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:padding="10dp"
        android:background="#1A1A20">

        <!-- Многострочное поле ввода -->
        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:maxHeight="120dp"
            android:minLines="1"
            android:maxLines="4"
            android:gravity="center_vertical"
            android:hint="Написать сообщение..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:background="@drawable/bg_search"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="actionSend"
            android:overScrollMode="ifContentScrolls" />

        <!-- Кнопка отправки -->
        <TextView
            android:id="@+id/sendButton"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="➤"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_create_button"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Отправить сообщение" />

    </LinearLayout>

</LinearLayout>
