<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101018"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Создать публикацию"
            android:textColor="#F7F5FF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:layout_marginBottom="7dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Поделись чем-нибудь с игровым сообществом"
            android:textColor="#9998BC"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="28dp" />

        <!-- Название -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✎  Название"
            android:textColor="#F5F2FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/postTitle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_post_input"
            android:hint="Например, мой первый рейд..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8988AD"
            android:textSize="15sp"
            android:singleLine="true"
            android:inputType="textCapSentences"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:imeOptions="actionNext" />

        <!-- Текст публикации -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▤  Текст публикации"
            android:textColor="#F5F2FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/postContent"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="@drawable/bg_post_input"
            android:hint="Расскажи подробнее..."
            android:textColor="#FFFFFF"
            android:textColorHint="#8988AD"
            android:textSize="15sp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="16dp"
            android:scrollbars="vertical" />

        <!-- Игра -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎮  Игра"
            android:textColor="#F5F2FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <Spinner
            android:id="@+id/postGameSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_post_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:popupBackground="#201F2D"
            android:spinnerMode="dropdown" />

        <!-- Тип публикации -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◆  Тип публикации"
            android:textColor="#F5F2FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <Spinner
            android:id="@+id/postTypeSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_post_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:popupBackground="#201F2D"
            android:spinnerMode="dropdown" />

        <!-- Теги -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="◆  Теги"
            android:textColor="#F5F2FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/postTagsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выбери игру и тип публикации"
            android:textColor="#9998BC"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/postTagsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Изображение -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▧  Обложка публикации"
            android:textColor="#F5F2FF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp" />

        <FrameLayout
            android:id="@+id/imageUploadArea"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/bg_post_upload"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="Добавить изображение к публикации">

            <LinearLayout
                android:id="@+id/imageUploadPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▧"
                    android:textColor="#A56AFF"
                    android:textSize="38sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/imageUploadHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ Добавить изображение"
                    android:textColor="#B58AFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Скриншот или обложка игры"
                    android:textColor="#8988AD"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- Кнопка публикации -->
        <Button
            android:id="@+id/publishButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_post_publish"
            android:backgroundTint="@null"
            android:elevation="3dp"
            android:stateListAnimator="@null"
            android:text="➤  Опубликовать"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Твоя публикация появится в ленте GamerHub"
            android:textColor="#8988AD"
            android:textSize="12sp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>
