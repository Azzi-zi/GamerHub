<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121216">

    <!-- Верхняя панель с кнопкой возврата -->
    <LinearLayout
        android:id="@+id/postDetailsToolbar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/postDetailsBackButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#B46EFF"
            android:textSize="36sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Назад" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Публикация"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Прокручиваемое содержимое статьи -->
    <ScrollView
        android:id="@+id/postDetailsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/postDetailsToolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Обложка публикации с категорией -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:background="#1A1A20">

                <!-- Изображение публикации -->
                <ImageView
                    android:id="@+id/postDetailsImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Обложка публикации" />

                <!-- Категория в левом нижнем углу -->
                <TextView
                    android:id="@+id/postDetailsType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_post_category"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="ГАЙДЫ"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- Заголовок -->
            <TextView
                android:id="@+id/postDetailsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Заголовок публикации"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Название игры -->
            <TextView
                android:id="@+id/postDetailsGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🎮 Название игры"
                android:textColor="#C8C8D0"
                android:textSize="14sp" />

            <!-- Автор -->
            <TextView
                android:id="@+id/postDetailsAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Автор: username"
                android:textColor="#9999A5"
                android:textSize="13sp" />

            <!-- Разделитель -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="#303039" />

            <!-- Полный текст публикации -->
            <TextView
                android:id="@+id/postDetailsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Текст публикации"
                android:textColor="#E0E0E6"
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:textIsSelectable="true" />

            <!-- Теги -->
            <TextView
                android:id="@+id/postDetailsTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="#B46EFF"
                android:textSize="13sp" />

            <!-- Панель лайков -->
            <LinearLayout
                android:id="@+id/postLikesPanel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/postLikeButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="64dp"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="#1A1A20"
                    android:text="🤍 0"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Поставить или убрать лайк" />

            </LinearLayout>

            <!-- Раздел комментариев -->
            <LinearLayout
                android:id="@+id/commentsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Комментарии"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/commentsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/commentsEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Пока нет комментариев. Будь первым!"
                    android:textColor="#A0A0AA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/commentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_search"
                    android:hint="Напиши комментарий..."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="1000"
                    android:minHeight="52dp"
                    android:padding="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#A0A0AA" />

                <Button
                    android:id="@+id/sendCommentButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#3478F6"
                    android:text="Отправить"
                    android:textColor="#FFFFFF" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
